<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Force HTTPS and www (hanya untuk domain produksi sbuexpress.com)
  RewriteCond %{HTTP_HOST} ^(www\.)?sbuexpress\.com$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.sbuexpress.com%{REQUEST_URI} [R=301,L]
  
  # Pastikan file fisik seperti sitemap.xml dan robots.txt diakses langsung
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Redirect semua request lainnya ke index.html untuk Flutter Path Strategy
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
